generator client {
  provider        = "prisma-client-js"
  // relationLoadStrategy: "join" — bog'langan ma'lumotlar bitta so'rovda (bazaga kamroq borish)
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  SUPERADMIN
}

enum Plan {
  FREE
  PAID
}

enum Channel {
  TELEGRAM
  WHATSAPP
}

enum OrderType {
  PICKUP
  DELIVERY
  /// Ordered from a table QR code (/{slug}?t=5) — no phone or address
  DINE_IN
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
  TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  NEW
  ACCEPTED
  READY
  ON_THE_WAY
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(OWNER)
  stores       Store[]
  createdAt    DateTime @default(now())
}

model Store {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  name                 String
  logoUrl              String?
  /// Wide header photo on the store page (same bucket/folder as the logo)
  coverUrl             String?
  /// Short text under the store name (**bold**, _italic_, ~~strike~~)
  description          String?
  /// Banner at the top of the store page ("Free delivery this weekend")
  announcement         String?
  /// Brand color "#16a05d" for buttons and highlights; null = platform green
  brandColor           String?
  /// Store page background: "gray" | "white" | "cream"
  pageBackground       String         @default("gray")
  /// Menu layout: "list" (rows) | "grid" (2 photo cards per row)
  menuLayout           String         @default("list")
  /// Font: "modern" | "friendly" | "elegant" | "classic" | "bold" (lib/design.ts)
  fontStyle            String         @default("modern")
  /// Corner rounding: "sharp" | "soft" | "round"
  cornerStyle          String         @default("soft")
  /// Store page header: "cover" | "centered" | "compact"
  headerStyle          String         @default("cover")
  showSearch           Boolean        @default(true)
  showDescriptions     Boolean        @default(true)
  /// Store page sections in order (lib/sections.ts): built-ins + owner text / image blocks; null = default order
  sections             Json?
  /// Social profiles (usernames, no @) shown as icons in the store header
  instagram            String?
  telegramChannel      String?
  tiktok               String?
  phone                String?
  address              String?
  landmark             String?
  openTime             String? // "09:00"
  closeTime            String? // "22:00"
  isOpen               Boolean        @default(true)
  channel              Channel        @default(TELEGRAM)
  telegramUsername     String?
  whatsappNumber       String?
  pickupEnabled        Boolean        @default(true)
  deliveryEnabled      Boolean        @default(true)
  /// Table QR ordering (OrderType.DINE_IN); tables are numbered 1..tableCount
  dineInEnabled        Boolean        @default(false)
  tableCount           Int            @default(0)
  /// Pul summalari (narx, tuman, minOrder) shu valyutaning eng kichik birligida: USD → sent
  currency             String         @default("USD")
  /// IANA vaqt zonasi (ish vaqti va "bugun" hisobi uchun), masalan "Europe/London"
  timeZone             String         @default("UTC")
  /// Default language of the store page (i18n/config locales) — used when the customer hasn't picked one
  locale               String         @default("en")
  minOrder             Int            @default(0)
  /// Flat delivery fee (minor units). Replaced per-area fees (DeliveryZone is no longer used).
  deliveryFee          Int            @default(0)
  /// Delivery is free when the items subtotal reaches this amount (minor units); null = off
  freeDeliveryFrom     Int?
  acceptCash           Boolean        @default(true)
  acceptCardOnDelivery Boolean        @default(true)
  acceptTransfer       Boolean        @default(false)
  transferDetails      String?
  plan                 Plan           @default(FREE)
  paidUntil            DateTime?
  /// Superadmin bloklagan: mijoz menyusi yopiq, buyurtma qabul qilinmaydi
  isBlocked            Boolean        @default(false)
  ownerId              String
  owner                User           @relation(fields: [ownerId], references: [id])
  categories           Category[]
  products             Product[]
  zones                DeliveryZone[]
  promoCodes           PromoCode[]
  pushSubscriptions    PushSubscription[]
  orders               Order[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([ownerId])
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id])
  name     String
  sort     Int       @default(0)
  isActive Boolean   @default(true)
  products Product[]

  @@index([storeId])
}

model Product {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  price        Int
  imageUrl     String?
  isAvailable  Boolean       @default(true)
  sort         Int           @default(0)
  optionGroups OptionGroup[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([storeId])
  @@index([categoryId])
}

model OptionGroup {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  required  Boolean  @default(false)
  maxSelect Int      @default(1)
  sort      Int      @default(0)
  options   Option[]

  @@index([productId])
}

model Option {
  id      String      @id @default(cuid())
  groupId String
  group   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name    String
  price   Int         @default(0)
  sort    Int         @default(0)

  @@index([groupId])
}

/// Deprecated: per-area delivery fees, replaced by Store.deliveryFee. Kept to avoid data loss.
model DeliveryZone {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  name    String
  fee     Int
  sort    Int    @default(0)

  @@index([storeId])
}

model Order {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  number        Int
  customerName  String
  /// Empty for DINE_IN orders (the customer is in the shop)
  customerPhone String
  type          OrderType
  /// DINE_IN: table number from the QR code
  tableNumber   Int?
  zoneName      String?
  address       String?
  landmark      String?
  /// Customer location from "Use my current location" (for a map link)
  latitude      Float?
  longitude     Float?
  scheduledFor  String?
  comment       String?
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  /// Bank transfer receipt photo: path in the private "payment-receipts" bucket
  receiptPath   String?
  receiptAt     DateTime?
  status        OrderStatus   @default(NEW)
  subtotal      Int
  deliveryFee   Int           @default(0)
  /// Promo code used (snapshot of the code text) and the discount it gave (minor units)
  promoCode     String?
  discount      Int           @default(0)
  /// subtotal - discount + deliveryFee
  total         Int
  /// Buyurtma paytidagi do'kon valyutasi (snapshot)
  currency      String        @default("USD")
  lang          String        @default("en")
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([storeId, number])
  @@index([storeId, createdAt])
  /// Admin "active orders" tab: status filter without scanning old completed orders
  @@index([storeId, status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  unitPrice Int
  quantity  Int
  options   Json?
  lineTotal Int

  @@index([orderId])
}

/// So'rovlar cheklovi (login, signup, buyurtma...). key: "login:ip:1.2.3.4"
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Store promo code. The customer enters `code` at checkout; the discount is applied to the items subtotal.
model PromoCode {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Upper case, letters/digits/dash
  code        String
  type        DiscountType
  /// PERCENT: 1..100; FIXED: amount in the store currency's minor unit
  value       Int
  /// Items subtotal needed to use the code (minor units, 0 = any)
  minSubtotal Int          @default(0)
  /// null = unlimited
  maxUses     Int?
  usedCount   Int          @default(0)
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([storeId, code])
}

/// A device (browser / installed admin app) that gets a push notification for every new order
model PushSubscription {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  /// Push service URL — unique per browser install
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// "iPhone · Safari" style label for the device list (not used for logic)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([storeId])
}
