# Local development: use a SEPARATE database, never production (seed, tests and `prisma migrate dev`
# can change or reset data). Quick local Postgres:
#   docker run -d --name order-db -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
#   DATABASE_URL="postgresql://postgres:dev@localhost:5432/postgres"
#   DIRECT_URL="postgresql://postgres:dev@localhost:5432/postgres"
#   npm run db:migrate && npm run db:seed
# Production values live only in Vercel → Settings → Environment Variables.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=""
# Asosiy domen: QR kod, do'kon havolasi va xabardagi buyurtma havolasi doim shu bo'ladi.
# Bo'sh qolsa — sayt qaysi manzilda ochilgan bo'lsa, o'sha ishlatiladi. Masalan: APP_URL="https://order.uz"
APP_URL=
# Vercel'da DATABASE_URL oxiriga: &connection_limit=3 (serverless'da ulanishlar tugab qolmasligi uchun)
# Admin sessiyasi uchun maxfiy kalit (kamida 32 belgi): openssl rand -base64 32
AUTH_SECRET=

# Sentry (xatolarni kuzatish). DSN: Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Source map yuklash uchun (faqat Vercel build'da kerak): Sentry → Settings → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Platform owner's Telegram username (without @) — "Upgrade to Pro" opens a chat here
SUPPORT_TELEGRAM=

# Web push (admin new-order notifications). Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com

# AI menu import (Products → Import from photo). Server-only secret — put the real key in .env
OPENAI_API_KEY=
# Optional, default gpt-4.1-mini (needs vision + structured outputs)
OPENAI_MODEL=
