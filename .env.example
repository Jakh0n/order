DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=""
# Asosiy domen: QR kod, do'kon havolasi va xabardagi buyurtma havolasi doim shu bo'ladi.
# Bo'sh qolsa — sayt qaysi manzilda ochilgan bo'lsa, o'sha ishlatiladi. Masalan: APP_URL="https://order.uz"
APP_URL=
# Vercel'da DATABASE_URL oxiriga: &connection_limit=3 (serverless'da ulanishlar tugab qolmasligi uchun)
# Admin sessiyasi uchun maxfiy kalit (kamida 32 belgi): openssl rand -base64 32
AUTH_SECRET=

# Sentry (xatolarni kuzatish). DSN: Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Source map yuklash uchun (faqat Vercel build'da kerak): Sentry → Settings → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Platform owner's Telegram username (without @) — "Upgrade to Pro" opens a chat here
SUPPORT_TELEGRAM=
